let TRUE = \x. \y. x
let FALSE = \x. \y. y


let 0 = \f. \x. x
let 1 = \f. \x. f x
let 2 = \f. \x. f (f x)
let 3 = \f. \x. f (f (f x))

let SUCC = \n. \f. \x. f (n f x)
let PLUS = \m. \n. \f. \x. m f (n f x)
let MULT = \m. \n. \f. m (n f)
let ISZERO = \n. n (\x. FALSE) TRUE

SUCC 0
PLUS 1 2
MULT 2 3
ISZERO 0
ISZERO 1
